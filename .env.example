# GitHub personal access token (classic) with `read:user` scope.
# Must be created by the portfolio owner so private contributions are included.
# Restart `npm start` after changing this file.
REACT_APP_GITHUB_TOKEN=

# EmailJS — https://dashboard.emailjs.com
# If send returns 412 / "Invalid grant", reconnect Gmail under Email Services.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
